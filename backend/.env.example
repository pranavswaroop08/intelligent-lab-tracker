MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=lab_asset_tracker

# Optional Direct Database URI (overrides individual MySQL settings if provided)
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/lab_asset_tracker

# Google Gemini API Key for Laboratory Safety AI Advisor
GEMINI_API_KEY=
